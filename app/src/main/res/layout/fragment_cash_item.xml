<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0F7FA"
    android:padding="20dp"
    tools:context=".CashItemFragment">


    <!-- OS 이미지 -->
    <ImageView
        android:id="@+id/topImage2"
        android:layout_width="68dp"
        android:layout_height="56dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="150dp"
        android:layout_marginTop="13dp"
        android:contentDescription="OS 이미지"
        android:src="@drawable/img" />

    <!-- 날짜 입력하는 부분 -->
    <EditText
        android:id="@+id/etDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="100dp"
        android:layout_marginBottom="10dp"
        android:hint="날짜 입력"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- 금액: 표시 칸 -->
    <TextView
        android:id="@+id/tvAmountLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/etDate"
        android:layout_alignParentStart="true"
        android:layout_marginStart="80dp"
        android:layout_marginTop="30dp"
        android:text="금액:" />

    <!-- 금액 입력하는 부분 -->
    <EditText
    android:id="@+id/etAmount"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_alignBaseline="@id/tvAmountLabel"
    android:layout_toEndOf="@id/tvAmountLabel"
    android:hint="금액 입력"
    android:inputType="number" />

    <!-- 내용: 표시 칸 -->
    <TextView
        android:id="@+id/tvContentLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvAmountLabel"
        android:layout_alignParentStart="true"
        android:layout_marginStart="80dp"
        android:layout_marginTop="28dp"
        android:text="내용:" />

    <!-- 내용 입력하는 부분 -->
    <EditText
    android:id="@+id/etContent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_alignBaseline="@id/tvContentLabel"
    android:layout_toEndOf="@id/tvContentLabel"
    android:hint="내용 입력"
    android:inputType="text" />

    <!-- 사진 아이콘 -->
    <ImageView
        android:id="@+id/ivImage"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_below="@id/etContent"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="90dp"
        android:contentDescription="사진 아이콘"
        app:srcCompat="@drawable/picture" />

    <!-- 삭제 버튼 -->
    <Button
        android:id="@+id/btnDelete"
        android:layout_width="80dp"
        android:layout_height="50dp"
        android:layout_below="@id/ivImage"
        android:layout_alignParentStart="true"
        android:layout_marginStart="80dp"
        android:layout_marginTop="80dp"
        android:backgroundTint="#FF8A80"
        android:text="삭제"
        android:textColor="#FFFFFF" />

    <!-- 완료 버튼 -->
    <Button
        android:id="@+id/btnComplete"
        android:layout_width="80dp"
        android:layout_height="50dp"
        android:layout_alignTop="@id/btnDelete"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="-1dp"
        android:layout_marginEnd="80dp"
        android:backgroundTint="#4CAF50"
        android:text="완료"
        android:textColor="#FFFFFF" />

</RelativeLayout>
