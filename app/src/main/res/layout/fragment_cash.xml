<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0F7FA"
    android:padding="20dp"
    tools:context=".CashFragment">

    <!-- Placeholder for Top Image -->
    <ImageView
        android:id="@+id/topImage"
        android:layout_width="68dp"
        android:layout_height="56dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="158dp"
        android:layout_marginTop="1dp"
        android:src="@drawable/img" />

    <!-- Title -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/topImage"
        android:layout_alignParentStart="true"
        android:layout_marginStart="24dp"
        android:layout_marginTop="1dp"
        android:text="2024 회계내역"
        android:textSize="24sp"
        android:textStyle="bold"
        android:translationX="0dp"
        android:translationY="35dp" />

    <!-- + 버튼 -->
    <Button
        android:id="@+id/addButton"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#2196F3"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:translationY="90dp" />

    <View
        android:id="@+id/titleUnderline"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@id/title"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="1dp"
        android:background="#000000"
        android:translationX="0dp"
        android:translationY="35dp" />

    <!-- Checklist Container with border -->
    <LinearLayout
        android:id="@+id/checklistContainer"
        android:layout_width="8dp"
        android:layout_height="470dp"
        android:layout_below="@id/titleUnderline"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:translationX="0dp"
        android:translationY="35dp">

        <!-- Checklist with Checkbox -->
        <ListView
            android:id="@+id/scheduleListView"
            android:layout_width="348dp"
            android:layout_height="match_parent"
            android:cacheColorHint="@android:color/transparent"
            android:divider="#000000"
            android:dividerHeight="1dp"
            android:listSelector="@android:color/transparent"
            android:translationX="0dp" />
    </LinearLayout>

    <!-- 하단 네비게이션 바 -->

</RelativeLayout>
