<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#E0F7FA"
    tools:context=".BudgetFragment">

    <!-- 상단 이미지 -->
    <ImageView
        android:id="@+id/topImage"
        android:layout_width="68dp"
        android:layout_height="56dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="150dp"
        android:layout_marginTop="13dp"
        android:src="@drawable/img" />

    <!-- 헤더 레이아웃 -->
    <LinearLayout
        android:id="@+id/scheduleHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topImage"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/scheduleTitle"
            android:layout_width="189dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="예산안"
            android:textSize="24sp"
            android:textStyle="bold"
            android:translationX="20dp" />

        <!-- 추가 버튼 -->
        <Button
            android:id="@+id/bud_add_button"
            android:layout_width="58dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="#89A4F8"
            android:text="+"
            android:textSize="16sp"
            android:textStyle="bold"
            app:rippleColor="#1E1F22" />

        <!-- 삭제 버튼 -->
        <Button
            android:id="@+id/bud_del_button"
            android:layout_width="58dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:backgroundTint="#F0726F"
            android:text="삭제"
            android:textAlignment="center"
            android:textColor="#090909"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@id/scheduleHeader"
        android:background="#000000" />

    <!-- RecyclerView: 예산 항목 리스트 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/budgetRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/scheduleHeader"
        android:layout_marginTop="8dp" />

</RelativeLayout>
