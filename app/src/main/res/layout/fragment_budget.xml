<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#E0F7FA"
    tools:context=".BudgetFragment">

    <ImageView
        android:id="@+id/topImage"
        android:layout_width="68dp"
        android:layout_height="56dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="13dp"
        android:src="@drawable/img" />

    <LinearLayout
        android:id="@+id/scheduleHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topImage"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/scheduleTitle"
            android:layout_width="189dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="예산안"
            android:textSize="24sp"
            android:textStyle="bold"
            android:translationX="20dp" />

        <Button
            android:id="@+id/bud_add_button"
            android:layout_width="58dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="#89A4F8"
            android:text="+"
            android:textSize="16sp"
            android:textStyle="bold"
            app:rippleColor="#1E1F22" />

        <Button
            android:id="@+id/bud_del_button"
            android:layout_width="58dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:backgroundTint="#F0726F"
            android:text="삭제"
            android:textAlignment="center"
            android:textColor="#090909"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@id/scheduleHeader"
        android:background="#000000" />

    <!-- RecyclerView를 하얀색 박스로 감싸기 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/scheduleHeader"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/budgetRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />
    </FrameLayout>

</RelativeLayout>
