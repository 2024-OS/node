<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#E0F7FA"
    tools:context=".CalendarFragment">

    <!-- Placeholder for Top Image -->
    <ImageView
        android:id="@+id/topImage"
        android:layout_width="68dp"
        android:layout_height="56dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="158dp"
        android:layout_marginTop="1dp"
        android:src="@drawable/img" />

    <!-- Title "캘린더" -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="캘린더"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_alignParentStart="true"
        android:layout_marginStart="32dp"
        android:layout_below="@id/topImage"
        android:layout_marginTop="1dp" />

    <!-- Underline -->
    <View
        android:id="@+id/titleUnderline"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#000000"
        android:layout_below="@id/title"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="1dp" />

    <!-- Calendar View -->
    <CalendarView
        android:id="@+id/calendarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/titleUnderline"
        android:layout_marginTop="4dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true" />

    <!-- Schedule Title and Buttons -->
    <LinearLayout
        android:id="@+id/scheduleHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/calendarView"
        android:layout_marginTop="1dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_alignParentStart="true">

        <TextView
            android:id="@+id/scheduleTitle"
            android:layout_width="201dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="&lt;1970년 1월 1일&gt;"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button3"
            android:layout_width="58dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="#89A4F8"
            android:text="+"
            android:textStyle="bold"
            app:rippleColor="#1E1F22" />

        <Button
            android:id="@+id/button4"
            android:layout_width="58dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:backgroundTint="#F0726F"
            android:text="삭제"
            android:textAlignment="center"
            android:textColor="#090909"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Checklist Container with border -->
    <LinearLayout
        android:id="@+id/checklistContainer"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/scheduleHeader"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Checklist with Checkbox -->
        <ListView
            android:id="@+id/scheduleListView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="#000000"
            android:dividerHeight="1dp"
            android:cacheColorHint="@android:color/transparent"
            android:listSelector="@android:color/transparent" />
    </LinearLayout>

</RelativeLayout>
