<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.example.node_project.viewmodel.CalendarViewModel" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#E0F7FA"
        tools:context=".CalendarFragment">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- 상단 이미지 -->
            <ImageView
                android:id="@+id/topImage"
                android:layout_width="68dp"
                android:layout_height="56dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="150dp"
                android:layout_marginTop="13dp"
                android:src="@drawable/img"
                android:contentDescription="캘린더 이미지" />

            <!-- '캘린더' 텍스트 -->
            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/topImage"
                android:layout_alignParentStart="true"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:text="캘린더"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <!-- 밑줄 -->
            <View
                android:id="@+id/titleUnderline"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#000000"
                android:layout_below="@id/title"
                android:layout_marginTop="4dp" />

            <!-- 캘린더 -->
            <CalendarView
                android:id="@+id/calendarView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/titleUnderline"
                android:layout_marginTop="16dp"
                android:onDateChangeListener="@{(view, year, month, dayOfMonth) -> viewModel.setDate(year + `년 ` + (month + 1) + `월 ` + dayOfMonth + `일`)}" />

            <!-- 스케줄 타이틀과 버튼 -->
            <LinearLayout
                android:id="@+id/scheduleHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/calendarView"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:weightSum="10">

                <!-- 스케줄 타이틀 -->
                <TextView
                    android:id="@+id/scheduleTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="6"
                    android:paddingStart="8dp"
                    android:text="@{viewModel.selectedDate} 할 일"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <!-- 추가 버튼 -->
                <Button
                    android:id="@+id/button3"
                    android:layout_width="23dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="2"
                    android:backgroundTint="#89A4F8"
                    android:onClick="@{() -> viewModel.addTask(`새 작업`)}"
                    android:text="추가"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- 삭제 버튼 -->
                <Button
                    android:id="@+id/button4"
                    android:layout_width="18dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:backgroundTint="#F0726F"
                    android:onClick="@{() -> viewModel.removeCheckedTasks()}"
                    android:text="삭제"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 흰색 박스로 감싼 RecyclerView -->
            <LinearLayout
                android:id="@+id/scheduleListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/scheduleHeader"
                android:layout_marginTop="16dp"
                android:padding="10dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:elevation="4dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/scheduleRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="vertical" />
            </LinearLayout>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
